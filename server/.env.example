# Copy to .env and fill in real values. Never commit .env.

MONGO_URI=mongodb://localhost:27017/awon-pharmacy

# JWT signing secret — must be at least 32 characters. Generate a strong one:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Comma-separated list of allowed browser origins (no trailing slashes).
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000

# production | development (production refuses to boot with a weak JWT_SECRET)
NODE_ENV=development

# Server port
PORT=5000
